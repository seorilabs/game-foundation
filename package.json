{
  "name": "seorilabs-game-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "python3 -m unittest discover -s tools -p 'test_*.py' -v && python3 tools/check.py",
    "test:e2e": "python3 tools/check.py",
    "check:architecture": "python3 tools/check_architecture.py",
    "check:bundle": "python3 tools/bundle.py verify",
    "review:render": "python3 tools/check.py --capture",
    "start": "python3 tools/run.py"
  }
}
